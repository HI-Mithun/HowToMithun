---
interface Props {
	title: string;
	description: string;
	href: string;
	comingSoon?: boolean;
}
const { title, description, href, comingSoon = false } = Astro.props;
---
<a

	href={href}
	class={`block p-6 rounded-lg border transition-colors ${
		comingSoon
			? 'border-dashed border-border dark:border-border-dark opacity-70 hover:opacity-100'
			: 'border-border dark:border-border-dark hover:border-accent dark:hover:border-accent-dark'
	}`}
>
	<div class="flex items-center justify-between mb-2">
		<h3 class="text-xl font-semibold text-text dark:text-text-dark">{title}</h3>
		{comingSoon && (
			<span class="font-mono text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full border border-border dark:border-border-dark text-text-muted dark:text-text-muted-dark">
				Soon
			</span>
		)}
	</div>
	<p class="text-text-muted dark:text-text-muted-dark text-sm">{description}</p>
</a>