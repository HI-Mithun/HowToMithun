---
interface Props {
	id: string;
	title: string;
	eyebrow?: string;

}
const { id, title, eyebrow } = Astro.props;
---

<section id={id} class="scroll-mt-24 mb-16">
	{eyebrow && (
		<p class="font-mono text-xs uppercase tracking-wider text-text-muted dark:text-text-muted-dark mb-2">
			{eyebrow}
		</p>
	)}
	<h2 class="text-2xl font-bold mb-8">{title}</h2>
	<div class="relative border-l-2 border-border dark:border-border-dark pl-8 space-y-10">
		<slot />
	</div>
</section>