---
const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/contact', label: 'Contact' },
];
---

<header class="border-b border-gray-200">
	<nav class="max-w-4xl mx-auto flex items-center justify-between px-4 py-4">
		<a href="/" class="font-bold text-lg">My Website</a>
		<ul class="flex gap-6">
			{navLinks.map((link) => (
				<li>
					<a href={link.href} class="text-gray-700 hover:text-blue-600">
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>