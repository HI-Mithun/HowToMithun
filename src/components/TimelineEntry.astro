---
import { formatDateRange } from '../utils/formatDate';

interface Props {
	title: string;
	subtitle?: string;
	startDate?: string;
	endDate?: string;
	meta?: string;
	link?: { label: string; href: string };
	bullets?: string[];
}
const { title, subtitle, startDate, endDate, meta, link, bullets } = Astro.props;
---

<div class="relative">
	<span
		class="absolute -left-[calc(2rem+5px)] top-1.5 w-3 h-3 rounded-full bg-accent dark:bg-accent-dark ring-4 ring-bg dark:ring-bg-dark"
	></span>

	<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
		<h3 class="font-semibold text-text dark:text-text-dark">{title}</h3>
		{startDate && (
			<span class="text-sm text-text-muted dark:text-text-muted-dark whitespace-nowrap">
				{formatDateRange(startDate, endDate ?? 'Present')}
			</span>
		)}
	</div>

	{subtitle && <p class="text-sm text-text-muted dark:text-text-muted-dark mt-0.5">{subtitle}</p>}
	{meta && <p class="text-sm text-text-muted dark:text-text-muted-dark mt-0.5">{meta}</p>}

	{link && (
		<a
			href={link.href}
			target="_blank"
			rel="noopener noreferrer"
			class="inline-block text-sm text-accent dark:text-accent-dark hover:underline mt-1"
		>
			{link.label} ↗
		</a>
	)}

	{bullets && bullets.length > 0 && (
		<ul class="mt-3 space-y-1.5 list-disc list-outside ml-4 text-sm text-text-muted dark:text-text-muted-dark">
			{bullets.map((b) => <li>{b}</li>)}
		</ul>
	)}
</div>