---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineSection from '../components/TimelineSection.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import ResumeNav from '../components/ResumeNav.astro';
import ShareButton from '../components/ShareButton.astro';
import {
	personalInfo,
	about,
	experience,
	education,
	projects,
	skills,
	languages,
	awards,
	hobbies,
} from '../data/resume';

const sections = [
	{ id: 'about', label: 'About', show: !!about },
	{ id: 'experience', label: 'Experience', show: experience.length > 0 },
	{ id: 'education', label: 'Education', show: education.length > 0 },
	{ id: 'projects', label: 'Projects', show: projects.length > 0 },
	{ id: 'skills', label: 'Skills', show: skills.length > 0 },
	{ id: 'languages', label: 'Languages', show: languages.length > 0 },
	{ id: 'awards', label: 'Awards', show: awards.length > 0 },
	{ id: 'hobbies', label: 'Interests', show: hobbies.length > 0 },
	{ id: 'contact', label: 'Contact', show: true },
].filter((s) => s.show);

const contactLinks = Object.entries(personalInfo.links).filter(([, url]) => !!url);
---

<BaseLayout
	title="Resume | How To Mithun"
	description="Background, experience, projects, and skills."
>
	<main class="max-w-4xl mx-auto px-4 py-16">
		<!-- Hero -->
		<div class="flex flex-wrap items-start justify-between gap-6 mb-16">
			<div>
				<h1 class="text-4xl font-bold mb-2">{personalInfo.name}</h1>
				<p class="text-text-muted dark:text-text-muted-dark">{personalInfo.location}</p>
			</div>
			<ShareButton />
		</div>

		<div class="lg:flex lg:gap-16">
			<ResumeNav sections={sections} />

			<div class="flex-1 min-w-0">
				{about && (
					<section id="about" class="scroll-mt-24 mb-16">
						<h2 class="text-2xl font-bold mb-4">About</h2>
						<p class="text-text-muted dark:text-text-muted-dark leading-relaxed max-w-2xl">
							{about}
						</p>
					</section>
				)}

				{experience.length > 0 && (
					<TimelineSection id="experience" title="Experience">
						{experience.map((e) => (
							<TimelineEntry
								title={e.role}
								subtitle={e.organization}
								startDate={e.startDate}
								endDate={e.endDate}
								bullets={e.responsibilities}
							/>
						))}
					</TimelineSection>
				)}

				{education.length > 0 && (
					<TimelineSection id="education" title="Education">
						{education.map((e) => (
							<TimelineEntry
								title={e.degree}
								subtitle={e.institution}
								startDate={e.startDate}
								endDate={e.endDate}
								meta={e.grade ? `Grade: ${e.grade}` : undefined}
								link={e.website ? { label: 'Website', href: e.website } : undefined}
							/>
						))}
					</TimelineSection>
				)}

				{projects.length > 0 && (
					<TimelineSection id="projects" title="Projects">
						{projects.map((p) => (
							<TimelineEntry
								title={p.title}
								subtitle={p.role}
								startDate={p.startDate}
								endDate={p.endDate}
							/>
						))}
					</TimelineSection>
				)}

				{skills.length > 0 && (
					<section id="skills" class="scroll-mt-24 mb-16">
						<h2 class="text-2xl font-bold mb-6">Skills</h2>
						<div class="space-y-5">
							{skills.map((group) => (
								<div>
									<h3 class="text-sm font-medium text-text-muted dark:text-text-muted-dark mb-2">
										{group.category}
									</h3>
									<div class="flex flex-wrap gap-2">
										{group.skills.map((skill) => (
											<span class="text-sm px-3 py-1 rounded-full border border-border dark:border-border-dark text-text dark:text-text-dark">
												{skill}
											</span>
										))}
									</div>
								</div>
							))}
						</div>
					</section>
				)}

				{languages.length > 0 && (
					<section id="languages" class="scroll-mt-24 mb-16">
						<h2 class="text-2xl font-bold mb-6">Languages</h2>
						<ul class="flex flex-wrap gap-3">
							{languages.map((l) => (
								<li class="text-sm px-3 py-1 rounded-full border border-border dark:border-border-dark">
									{l.name} <span class="text-text-muted dark:text-text-muted-dark">— {l.fluency}</span>
								</li>
							))}
						</ul>
					</section>
				)}

				{awards.length > 0 && (
					<TimelineSection id="awards" title="Awards & Honours">
						{awards.map((a) => (
							<TimelineEntry
								title={a.title}
								subtitle={a.awardingInstitution}
								startDate={a.date}
								endDate={a.date}
								bullets={[a.description]}
							/>
						))}
					</TimelineSection>
				)}

				{hobbies.length > 0 && (
					<section id="hobbies" class="scroll-mt-24 mb-16">
						<h2 class="text-2xl font-bold mb-6">Interests</h2>
						<div class="grid sm:grid-cols-2 gap-6">
							{hobbies.map((h) => (
								<div class="p-4 rounded-lg border border-border dark:border-border-dark">
									<h3 class="font-semibold mb-1">{h.title}</h3>
									<p class="text-sm text-text-muted dark:text-text-muted-dark leading-relaxed">
										{h.description}
									</p>
								</div>
							))}
						</div>
					</section>
				)}

				<section id="contact" class="scroll-mt-24">
					<h2 class="text-2xl font-bold mb-6">Contact</h2>
					<ul class="space-y-2 text-sm">
						<li>
							<a href={`mailto:${personalInfo.email}`} class="text-accent dark:text-accent-dark hover:underline">
								{personalInfo.email}
							</a>
						</li>
						<li class="text-text-muted dark:text-text-muted-dark">{personalInfo.phone}</li>
						<li class="text-text-muted dark:text-text-muted-dark">{personalInfo.location}</li>
						{contactLinks.map(([key, url]) => (
							<li>
								<a href={url} target="_blank" rel="noopener noreferrer" class="text-accent dark:text-accent-dark hover:underline capitalize">
									{key} ↗
								</a>
							</li>
						))}
					</ul>
				</section>
			</div>
		</div>
	</main>
</BaseLayout>