---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | My Website">
	<main class="max-w-2xl mx-auto px-4 py-24 text-center">
		<h1 class="text-5xl font-bold mb-4">404</h1>
		<p class="text-gray-600 mb-8">This page doesn't exist — maybe it moved, or maybe it was never built yet.</p>
		<a href="/" class="text-blue-600 hover:underline">&larr; Back to Home</a>
	</main>
</BaseLayout>