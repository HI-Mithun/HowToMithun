---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
	{
		title: 'This Website',
		description: 'Built with Astro, Tailwind, and Markdown content collections.',
		tags: ['Astro', 'Tailwind', 'TypeScript'],
		link: 'https://github.com/yourusername/myname-website',
	},
	// Add more projects here as you build them —
	// same shape: title, description, tags, link
];
---

<BaseLayout title="Projects | My Website" description="Things I've built.">
	<main class="max-w-3xl mx-auto px-4 py-16">
		<h1 class="text-3xl font-bold mb-8">Projects</h1>

		<div class="grid gap-6 sm:grid-cols-2">
			{projects.map((project) => (
				<a
					href={project.link}
					target="_blank"
					rel="noopener noreferrer"
					class="block p-6 border border-gray-200 rounded-lg hover:border-blue-600 transition-colors"
				>
					<h2 class="text-lg font-semibold mb-2">{project.title}</h2>
					<p class="text-gray-600 text-sm mb-3">{project.description}</p>
					<div class="flex gap-2 flex-wrap">
						{project.tags.map((tag) => (
							<span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">
								{tag}
							</span>
						))}
					</div>
				</a>
			))}
		</div>
	</main>
</BaseLayout>