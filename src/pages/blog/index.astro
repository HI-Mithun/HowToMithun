---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', (post: CollectionEntry<'blog'>) => {
	return post.data.draft !== true;
});

const sortedPosts = allPosts.sort(
	(a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog | How To Mithun">
	<main class="max-w-2xl mx-auto px-4 py-16">
		<h1 class="text-3xl font-bold mb-8">Blog</h1>

		<ul class="space-y-6">
			{sortedPosts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`} class="block group">
						<h2 class="text-xl font-semibold group-hover:text-blue-600">
							{post.data.title}
						</h2>
						<p class="text-sm text-gray-500">
							{post.data.pubDate.toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
							})}
						</p>
						<p class="text-gray-600 mt-1">{post.data.description}</p>
					</a>
				</li>
			))}
		</ul>
	</main>
</BaseLayout>