---
import BaseLayout from '../layouts/BaseLayout.astro';

const contactLinks = [
	{ label: 'Email', href: 'mailto:hi.mithun004@gmail.com', value: 'hi.mithun004@gmail.com' },
	{ label: 'GitHub', href: 'https://github.com/HI-Mithun', value: '@HI-Mithun' },
	{ label: 'Facebook', href: 'https://web.facebook.com/himmithun/', value: 'Himithun' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/hasan-imam-mithun/', value: 'Hasan Imam Mithun' },
	{ label: 'Instagram', href: 'https://www.instagram.com/hi.mithun/', value: '@hi.mithun' },
];
---

<BaseLayout title="Contact | How To Mithun" description="Get in touch.">
	<main class="max-w-2xl mx-auto px-4 py-16">
		<h1 class="text-3xl font-bold mb-6">Contact</h1>
		<p class="text-text-muted dark:text-text-muted-dark mb-8">
			Feel free to reach out — I'm happy to chat about projects, collaboration, or anything on the site.
		</p>
		<ul class="space-y-3">
			{contactLinks.map((link) => (
				<li>
					<span class="text-sm text-gray-500">{link.label}:</span>{' '}
					<a href={link.href} class="text-blue-600 hover:underline">{link.value}</a>
				</li>
			))}
		</ul>
	</main>
</BaseLayout>