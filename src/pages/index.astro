---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreCard from '../components/ExploreCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { titleFromId } from '../utils/formatTitle';
import { personalInfo, about } from '../data/resume';

// --- Blog ---
const allPosts = await getCollection('blog', ({ data }) => data.draft !== true);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const hasBlog = sortedPosts.length > 0;
const latestPosts = sortedPosts.slice(0, 3);

// --- Sketchbook ---
const allSketches = await getCollection('sketches');
const hasSketchbook = allSketches.length > 0;

// "Meaningful" = has real title + description, not just a bare image.
const meaningfulSketches = allSketches
	.filter((s) => s.data.title !== undefined && s.data.description !== undefined)
	.sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
const featuredSketches = meaningfulSketches.slice(0, 6);

// --- About ---
// Manual flag: about.astro has real content today, confirmed by inspection.
// Can't be derived automatically without turning About into a collection.
const hasAboutPage = true;

// --- Explore categories ---
// Programming, Projects, Machine Learning, Game Guides, Teaching are
// intentionally absent — no content collection exists for them yet, so
// there's nothing to check. Add them here once they have real content.
const exploreCategories = [
	{
		title: 'Writing',
		description: 'Essays, tutorials, and things I\'m learning, written down.',
		href: '/blog',
		show: hasBlog,
		comingSoon: false,
	},
	{
		title: 'Sketchbook',
		description: 'A visual journal of drawings and sketches.',
		href: '/sketchbook',
		show: hasSketchbook,
		comingSoon: false,
	},
	{
		title: 'Chess',
		description: 'Games, puzzles, and thoughts on chess improvement.',
		href: '/chess',
		show: true,
		comingSoon: true,
	},
	{
		title: 'Animations',
		description: 'Short animation experiments, hosted on YouTube.',
		href: '/animation',
		show: true,
		comingSoon: true,
	},
].filter((c) => c.show);

// --- Hero actions ---
const heroActions = [
	{ label: 'Read the Blog', href: '/blog', show: hasBlog },
	{ label: 'Explore the Sketchbook', href: '/sketchbook', show: hasSketchbook },
	{ label: 'View Resume', href: '/resume', show: true },
].filter((a) => a.show);
---

<BaseLayout title="Home | How To Mithun" description="Personal site of Mithun — writing, sketches, and a bit of everything else.">
	<main class="max-w-4xl mx-auto px-4">
		<!-- Hero -->
		<section class="py-20 text-center">
			<h1 class="text-4xl font-bold mb-4">Hi, I'm Mithun.</h1>
			<p class="text-lg text-text-muted dark:text-text-muted-dark max-w-xl mx-auto mb-8">
				A Computer Science graduate who enjoys building things, learning, teaching,
				sketching, writing, and exploring new ideas.
			</p>
			<div class="flex flex-wrap justify-center gap-3">
				{heroActions.map((action, i) => (
					<a
						href={action.href}
						class={
							i === 0
								? 'px-5 py-2.5 rounded-full bg-accent dark:bg-accent-dark text-white dark:text-bg-dark text-sm font-medium hover:opacity-90 transition-opacity'
								: 'px-5 py-2.5 rounded-full border border-border dark:border-border-dark text-sm font-medium hover:border-accent dark:hover:border-accent-dark transition-colors'
						}
					>
						{action.label}
					</a>
				))}
			</div>
		</section>

		<!-- About -->
		<section class="max-w-2xl mx-auto pb-20 text-center">
			<p class="text-text-muted dark:text-text-muted-dark leading-relaxed">
				{about.split('. ').slice(0, 2).join('. ')}.
			</p>
			{hasAboutPage && (
				<a href="/about" class="inline-block mt-4 text-sm text-accent dark:text-accent-dark hover:underline">
					More about me &rarr;
				</a>
			)}
		</section>

		<!-- Explore -->
		{exploreCategories.length > 0 && (
			<section class="pb-20">
				<h2 class="text-2xl font-bold mb-6">Explore</h2>
				<div class="grid gap-6 sm:grid-cols-2">
					{exploreCategories.map((c) => (
						<ExploreCard title={c.title} description={c.description} href={c.href} comingSoon={c.comingSoon} />
					))}
				</div>
			</section>
		)}

		<!-- Featured Sketchbook -->
		{featuredSketches.length > 0 && (
			<section class="pb-20">
				<div class="flex items-center justify-between mb-6">
					<h2 class="text-2xl font-bold">From the Sketchbook</h2>
					<a href="/sketchbook" class="text-sm text-accent dark:text-accent-dark hover:underline">
						View Sketchbook &rarr;
					</a>
				</div>
				<div class="columns-2 sm:columns-3 gap-3">
					{featuredSketches.map((s) => (
						<a
							href={`/sketchbook/${s.id}`}
							class="block mb-3 break-inside-avoid rounded-2xl overflow-hidden border border-border dark:border-border-dark group"
						>
							<Image src={s.data.image} alt={s.data.title ?? titleFromId(s.id)} class="w-full h-auto" />
							<div class="p-3">
								<p class="text-sm font-medium text-text dark:text-text-dark">
									{s.data.title ?? titleFromId(s.id)}
								</p>
								{s.data.description && (
									<p class="text-xs text-text-muted dark:text-text-muted-dark mt-1 line-clamp-2">
										{s.data.description}
									</p>
								)}
							</div>
						</a>
					))}
				</div>
			</section>
		)}

		<!-- Latest Blog Posts -->
		{hasBlog && (
			<section class="pb-20">
				<div class="flex items-center justify-between mb-6">
					<h2 class="text-2xl font-bold">Latest from the Blog</h2>
					<a href="/blog" class="text-sm text-accent dark:text-accent-dark hover:underline">
						Read the Blog &rarr;
					</a>
				</div>
				<div class="grid gap-4 sm:grid-cols-3">
					{latestPosts.map((post) => (
						<a
							href={`/blog/${post.id}/`}
							class="block p-5 rounded-lg border border-border dark:border-border-dark hover:border-accent dark:hover:border-accent-dark transition-colors"
						>
							{post.data.category && (
								<span class="font-mono text-[10px] uppercase tracking-wider text-text-muted dark:text-text-muted-dark">
									{post.data.category}
								</span>
							)}
							<h3 class="font-semibold text-text dark:text-text-dark mt-1 mb-1">{post.data.title}</h3>
							<p class="text-sm text-text-muted dark:text-text-muted-dark line-clamp-2 mb-2">
								{post.data.description}
							</p>
							<p class="text-xs text-text-muted dark:text-text-muted-dark">
								{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
							</p>
						</a>
					))}
				</div>
			</section>
		)}

		<!-- Resume CTA -->
		<section class="pb-20">
			<div class="rounded-lg border border-border dark:border-border-dark p-8 text-center max-w-2xl mx-auto">
				<h2 class="text-xl font-bold mb-2">Want to know more about my background?</h2>
				<p class="text-text-muted dark:text-text-muted-dark mb-5">
					Explore my education, skills, experience, and projects.
				</p>
				<a
					href="/resume"
					class="inline-block px-5 py-2.5 rounded-full bg-accent dark:bg-accent-dark text-white dark:text-bg-dark text-sm font-medium hover:opacity-90 transition-opacity"
				>
					View Resume &rarr;
				</a>
			</div>
		</section>
	</main>
</BaseLayout>